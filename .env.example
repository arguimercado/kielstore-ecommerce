# Neon Postgres connection string (Neon dashboard → Connect).
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app (used by the server and the auth client)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (server only)
# A restricted key (rk_...) from Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=""
# Webhook signing secret (whsec_...). Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
